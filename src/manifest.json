{
  "manifest_version": 3,
  "name": "Zimu — Mandarin subtitles for Jellyfin",
  "short_name": "Zimu",
  "version": "0.6.1",
  "description": "Interactive Chinese subtitles in the Jellyfin web player: hanzi, pinyin, English, click-to-define, and flashcards that link back to the moment.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zimu flashcards",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://jellyfin.example.com/*",
    "http://jellyfin-host/*",
    "http://192.0.2.10/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://translate.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jellyfin.example.com/*",
        "http://jellyfin-host/*",
        "http://192.0.2.10/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "vendor/pinyin-pro.js",
        "lib/core.js",
        "lib/dict.js",
        "lib/store.js",
        "content/jellyfin.js",
        "content/main.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/cedict.u8"
      ],
      "matches": [
        "https://jellyfin.example.com/*",
        "http://jellyfin-host/*",
        "http://192.0.2.10/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zimu@nicholaspsmith",
      "strict_min_version": "128.0"
    }
  }
}
